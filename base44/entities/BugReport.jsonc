{
  "name": "BugReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title describing the bug"
    },
    "description": {
      "type": "string",
      "description": "User's description of the issue"
    },
    "code_snippet": {
      "type": "string",
      "description": "Troubleshooting code generated by Rayma AI"
    },
    "page_url": {
      "type": "string",
      "description": "URL where the bug was encountered"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "resolved"
      ],
      "default": "submitted",
      "description": "Current status of the bug report"
    }
  },
  "required": [
    "title",
    "code_snippet"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}