{
  "name": "AdminEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Admin recipient email address"
    },
    "label": {
      "type": "string",
      "description": "Optional label (e.g. 'Primary Admin', 'Developer')"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this email currently receives bug reports"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}