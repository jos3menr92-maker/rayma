{
  "name": "Loan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Loan name (e.g. Car Loan, Credit Card)"
    },
    "lender": {
      "type": "string",
      "description": "Lender or institution name"
    },
    "original_amount": {
      "type": "number",
      "description": "Original loan amount"
    },
    "current_balance": {
      "type": "number",
      "description": "Current remaining balance"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate percentage (APR)"
    },
    "monthly_payment": {
      "type": "number",
      "description": "Payment amount \u2014 interpreted per payment_amount_type (per-period or monthly-equivalent)"
    },
    "payment_amount_type": {
      "type": "string",
      "enum": [
        "per_period",
        "monthly_equivalent"
      ],
      "default": "per_period",
      "description": "How monthly_payment is stored: per_period = amount paid each cycle; monthly_equivalent = the monthly-equivalent figure (converted for calc)"
    },
    "payment_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "weekly",
        "biweekly"
      ],
      "default": "monthly",
      "description": "How often loan payments are made"
    },
    "term_months": {
      "type": "number",
      "description": "Loan term in months (e.g. 360 for 30-yr mortgage). Null for revolving (credit card / line of credit) or unknown."
    },
    "due_day": {
      "type": "number",
      "description": "Day of month payment is due (1-31), for monthly loans"
    },
    "due_day_of_week": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "description": "Day of week payment is due, for weekly/biweekly loans"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Loan start date"
    },
    "category": {
      "type": "string",
      "enum": [
        "mortgage",
        "auto",
        "student",
        "personal",
        "credit_card",
        "line_of_credit",
        "lease",
        "bankruptcy",
        "medical",
        "other"
      ],
      "description": "Loan type \u2014 drives the math mode (amortizing, revolving, simple)"
    },
    "loan_type_attributes": {
      "type": "object",
      "description": "Type-specific structured fields (mortgage escrow/PMI/address, auto vehicle/VIN, credit card limit/utilization, line of credit limit/draw, lease buyout, bankruptcy case/trustee)"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "original_amount",
    "current_balance"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}