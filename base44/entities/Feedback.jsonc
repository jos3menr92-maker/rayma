{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "rating": {
      "type": "number",
      "description": "Star rating 1-5"
    },
    "message": {
      "type": "string",
      "description": "User's feedback message"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "feature_request",
        "general",
        "compliment"
      ],
      "default": "general",
      "description": "Type of feedback"
    },
    "page": {
      "type": "string",
      "description": "Page the user was on when submitting feedback"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional details"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status \u2014 only approved reviews are eligible for public display"
    },
    "public_consent": {
      "type": "boolean",
      "default": false,
      "description": "User consented to their review being featured publicly (name shown only, never email)"
    },
    "feature_on_landing": {
      "type": "boolean",
      "default": false,
      "description": "Admin toggle \u2014 show this review on the public landing page (requires status=approved and public_consent=true)"
    },
    "display_name": {
      "type": "string",
      "description": "Name shown publicly if featured (first name + last initial)"
    }
  },
  "required": [
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}