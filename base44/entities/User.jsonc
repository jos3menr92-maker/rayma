{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "preferred_name": {
      "type": "string"
    },
    "avatar_id": {
      "type": "string"
    },
    "avatar_emoji": {
      "type": "string"
    },
    "avatar_photo_url": {
      "type": "string"
    },
    "preferred_currency": {
      "type": "string",
      "default": "USD"
    },
    "preferred_language": {
      "type": "string",
      "default": "en",
      "description": "ISO language code (en, zh, hi, es, fr, ar, bn, pt, ru, ja)"
    },
    "dashboard_greeting": {
      "type": "string"
    },
    "pay_frequency": {
      "type": "string"
    },
    "pay_day": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "compact_mode": {
      "type": "boolean",
      "default": false
    },
    "smart_alerts": {
      "type": "boolean",
      "default": true
    },
    "auto_insights": {
      "type": "boolean",
      "default": true
    },
    "deficit_alert_key": {
      "type": "string",
      "description": "Date (YYYY-MM-DD) of the projected deficit trough the user was last alerted about \u2014 dedupes repeat alerts for the same deficit"
    },
    "deficit_alert_sent_at": {
      "type": "string",
      "format": "date",
      "description": "When the last deficit alert was sent \u2014 repeat guard for the same trough"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the initial onboarding flow. Set to true at the end of Onboarding; Dashboard redirects here while false/undefined."
    },
    "rayma_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Legacy expiry field \u2014 kept for backward compat"
    },
    "ai_tokens": {
      "type": "number",
      "default": 15,
      "description": "AI coin balance. 3 coins = 1 question or 1 scan. Free users get 15 coins/week (5 questions), topped up weekly and not carried over. Purchased and earned coins carry over forever."
    },
    "ai_tokens_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Date when the weekly free-coin top-up was last applied"
    },
    "arcade_coins_earned_today": {
      "type": "number",
      "default": 0,
      "description": "Arcade coins earned today (UTC). Server-side farming guard \u2014 caps Play-to-Earn at 6 coins/day per user."
    },
    "arcade_coins_earned_date": {
      "type": "string",
      "format": "date",
      "description": "UTC date for the daily arcade coin cap tracking. When it no longer matches today, the counter resets to 0."
    },
    "annual_pass_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date when annual pass expires. If set and in future, unlimited AI."
    },
    "game_access_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date when sponsor-only arcade game access expires. If set and in future, unlocks the 3 sponsor-only games. Granted via game_access promo codes (30 days each, stacks)."
    },
    "is_sponsor": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is a sponsor or employee (redeemed promo code)"
    },
    "energy_bars": {
      "type": "number",
      "default": 15,
      "description": "Legacy field \u2014 kept for backward compat. ai_tokens is the single source of truth."
    },
    "purchased_energy": {
      "type": "number",
      "default": 0,
      "description": "Legacy field \u2014 kept for backward compat. ai_tokens is the single source of truth."
    },
    "last_energy_reset": {
      "type": "string",
      "format": "date",
      "description": "Legacy field \u2014 kept for backward compat."
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "power_lithium",
        "power_generator",
        "power_unlimited"
      ],
      "default": "free",
      "description": "Active Stripe subscription tier. Set by the Stripe webhook on purchase. 'free' when no active subscription."
    },
    "subscription_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date when the current Stripe subscription period ends. Null if the user is on the free tier."
    },
    "subscription_type": {
      "type": "string",
      "description": "Display label for current subscription"
    },
    "ai_tokens_daily_limit": {
      "type": "number",
      "default": 15,
      "description": "Legacy field \u2014 weekly free-coin allowance (15). Kept for backward compat."
    }
  },
  "required": []
}